# simple pthread Makefile.gcc6 - for Bebbo's gcc-6

HEADERS =
SOURCES =

PREFIX ?= /opt/amiga

CC = m68k-amigaos-gcc
CXX = m68k-amigaos-g++
AR = m68k-amigaos-ar
AS = m68k-amigaos-as

uname := $(shell uname)
root ?= $(shell echo $$PWD)
export root

# the recursive makes read only this file, not the generic Makefile next to it
SUBMAKE = $(MAKE) -f $(root)/Makefile.gcc6

# special path handling for msys2 started from Eclipse
ifneq (,$(findstring MSYS_NT,$(uname)))
ifneq (,$(findstring /cygdrive/,$(root)))
troot := $(root)
tdrive := $(word 2,$(subst /, ,$(troot)))
root = $(subst /cygdrive/$(tdrive)/,$(tdrive):/,$(troot))
endif
endif

ifneq (,$(lib))
ifeq (,$(libname))
libname=$(lib)
endif
endif

# extend CFLAGS on first invokation
ifeq (,$(kind))
CFLAGS ?= -Os -fomit-frame-pointer
CFLAGS += -noixemul -I$(root)
endif

# The multilibs are the compiler's: -print-multi-lib lists one library
# directory per line with the options that select it after a ';', each
# prefixed with '@' (libb/libm020;@fbaserel@m68020-60).  The base directory
# '.' is built in lib/, every other one in a directory of its own name.
# libpthread has no floating point, so the FPU directories (m68881) are
# skipped: the linker falls back to their parent.
MULTILIBS := $(filter-out %m68881,$(shell $(CC) -print-multi-lib))
multilib_dir = $(word 1,$(subst ;, ,$1))
multilib_flags = $(strip $(subst @, -,$(word 2,$(subst ;, ,$1))))
multilib_kind = $(if $(filter .,$(call multilib_dir,$1)),lib,$(call multilib_dir,$1))
KINDS = $(foreach m,$(MULTILIBS),$(call multilib_kind,$m))

.PHONY: all one clean install install_one check check_one
all: info $(KINDS)
check: $(foreach k,$(KINDS),check_$(subst /,_,$k))
install: $(foreach k,$(KINDS),install_$(subst /,_,$k))

# per multilib: build in its directory, build the tests against it, install
# into the same directory under $(PREFIX)/m68k-amigaos/lib
define multilib_rules
.PHONY: $(2) check_$(subst /,_,$(2)) install_$(subst /,_,$(2))
$(2):
	@mkdir -p $$@
	$$(SUBMAKE) one kind=$$@ flags="$(3)" CFLAGS="$$(CFLAGS)"
check_$(subst /,_,$(2)):
	$$(SUBMAKE) check_one kind=$(2) flags="$(3)"
install_$(subst /,_,$(2)):
	$$(SUBMAKE) install_one kind=$(2) to="$(if $(filter .,$(1)),,$(1)/)"
endef
$(foreach m,$(MULTILIBS),$(eval $(call multilib_rules,$(call multilib_dir,$m),$(call multilib_kind,$m),$(call multilib_flags,$m))))

check_one:
	@mkdir -p $(kind)
	$(SUBMAKE) one kind=$(kind) flags="$(flags)" CFLAGS="$(CFLAGS)"
	@mkdir -p $(kind)/tests
	$(CC) $(flags) -mcrt=nix20 -O2 -Wall -I$(root) \
		$(root)/tests/joinsig.c -L$(kind) -lpthread -o $(kind)/tests/joinsig
	@if printf '#include <thread>\n#ifndef _GLIBCXX_HAS_GTHREADS\n#error no thread support\n#endif\n' | \
		$(CXX) $(flags) -x c++ -fsyntax-only - >/dev/null 2>&1; then \
		$(SUBMAKE) check_cxx_one kind=$(kind) flags="$(flags)"; \
	else echo "SKIP $(kind) C++ tests: libstdc++ has no thread support"; fi

.PHONY: check_cxx_one
check_cxx_one:
	$(CXX) $(flags) -mcrt=nix20 -m68881 -O2 -std=gnu++23 -I$(root) \
		$(root)/tests/t3race.cpp -L$(kind) -lpthread -latomic -o $(kind)/tests/t3race
	$(CXX) $(flags) -mcrt=nix20 -m68881 -O2 -std=gnu++23 -I$(root) \
		$(root)/tests/t3w_warm.cpp -L$(kind) -lpthread -latomic -o $(kind)/tests/t3w_warm

# the libs to build for each kind
one: pthread

# install the files for the given $(kind) into $(to)
install_one:
	mkdir -p $(PREFIX)/m68k-amigaos/lib/$(to)
	cp $(kind)/*.a $(PREFIX)/m68k-amigaos/lib/$(to)
	

# startup stuff
.PHONY: libdir
libdir:
	@mkdir -p lib

lib/devinit.o: $(root)/$(SOURCES)/startup/devinit.c libdir
	$(CC) -c $(CFLAGS) $(flags) $< -o $@

lib/libinit.o: $(root)/$(SOURCES)/startup/libinit.c libdir
	$(CC) -c $(CFLAGS) $(flags) $< -o $@

lib/libinitr.o: $(root)/$(SOURCES)/startup/libinitr.c libdir
	$(CC) -c $(CFLAGS) $(flags) $< -o $@

lib/ncrt0.o: $(root)/$(SOURCES)/startup/ncrt0.S libdir
	$(AS) $< -o $@

lib/nbcrt0.o: $(root)/$(SOURCES)/startup/nbcrt0.S libdir
	$(AS) $< -o $@

lib/nlbcrt0.o: $(root)/$(SOURCES)/startup/nlbcrt0.S libdir
	$(AS) $< -o $@

lib/nrcrt0.o: $(root)/$(SOURCES)/startup/nrcrt0.S libdir
	$(AS) $< -o $@

lib/nlrcrt0.o: $(root)/$(SOURCES)/startup/nlrcrt0.S libdir
	$(AS) $< -o $@

.PHONY: pthread
pthread:
	$(SUBMAKE) -C $(kind) libpthread.a lib=pthread

# build the lib base on $(lib), $(kind) and $(flags)
lib$(libname).a: $(root)/pthread.c $(root)/sched.c $(root)/semaphore.c $(stolen) $(shell find $(root)/$(HEADERS)/* -name '*.h') $(root)/Makefile.gcc6
	@mkdir -p $(lib)
	@echo compiling for $(kind)/$@ using $(CC) -c $(CFLAGS) $(flags)
	@touch -t 0001010000 $(lib)/stamp && if [ -e $@ ]; then touch -r $@ $(lib)/stamp; fi
	@if [ "$$(find $(root)/$(HEADERS)/* -newer $(lib)/stamp)" != "" ]; then rm -f $(lib)/*.o $@; touch -t 0001010000 $(lib)/stamp; fi
	@if [ "$$(find $(root)/Makefile.gcc6 -newer $(lib)/stamp)" != "" ]; then rm -f $(lib)/*.o $@; touch -t 0001010000 $(lib)/stamp; fi
	@cd $(lib) && files="$$(find $^ -name '*.c' -newer stamp)" && echo "$(CC) -c $(CFLAGS) $(flags) $$files" && $(CC) -c $(CFLAGS) $(flags) $$files 
	@#echo archive $(kind)/$@
	@$(AR) rcs $@ $$(find ./$(lib)/* -name '*.o' -newer $(lib)/stamp)


# cleanup
clean:
	find * -name '*.o' -delete
	find * -name '*.a' -delete
	find * -name stamp -delete

info:
	@echo "$(uname)"
	@echo "root=$(root)"
